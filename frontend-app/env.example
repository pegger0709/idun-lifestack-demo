# ================================================
# FRONTEND .env - API Configuration
# ================================================
# This file goes in the frontend-app/ directory
#
# Choose ONE option based on where you're running the app:

# Option 1: iOS Simulator (DEFAULT - works on same computer)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Option 2: Android Emulator (special localhost for Android)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Option 3: Physical Device (iPhone/Android/Pixel)
# Replace <YOUR_COMPUTER_IP> with your actual IP address
# Find your IP:
#   macOS/Linux: ifconfig | grep "inet " | grep -v 127.0.0.1
#   Windows: ipconfig (look for IPv4 Address)
# EXPO_PUBLIC_API_URL=http://<YOUR_COMPUTER_IP>:8000
#
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
#
# IMPORTANT: Computer and phone must be on same WiFi network!