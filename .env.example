# ================================================
# ROOT .env - Backend Configuration
# ================================================
# This file goes in the PROJECT ROOT directory
#
# IDUN Guardian API Token
# Get your token from: https://www.iduntechnologies.com/
# Sign up → API settings → Copy token (starts with 'idun_')
IDUN_API_TOKEN=idun_your_token_here

# Mock Device Mode - set to 'true' to use simulated device instead of real hardware
# Generates synthetic impedance (200 kΩ) and EEG data (10 Hz alpha wave)
# Useful for testing the app workflow without physical Guardian earbuds
# USE_MOCK_DEVICE=true
